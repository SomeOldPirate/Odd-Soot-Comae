<div class="oddsoot-chat-card">
  <div class="card-header">
    <div class="header-text">
      <h3 style="color: var(--os-gold) !important; text-shadow: 2px 2px 0px #000;">{{weaponName}}</h3>
      </div>

    <div class="actor-icon" style="background-image: url('{{img}}');"></div>
  </div>

  <div class="card-body">
    <div class="roll-details">
      <div class="roll-box primary">
        <span class="label">DAMAGE</span>
        <span class="value">{{roll}}</span>
      </div>
    </div>

    <div class="breakdown">
      Rolling Damage ({{formula}})
    </div>
  </div>
</div>