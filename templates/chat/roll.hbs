<div class="dice-roll oc-roll" data-action="expandRoll">
  {{#if flavor}}<div class="dice-flavor oc-roll__flavor">{{flavor}}</div>{{/if}}
  <div class="dice-result oc-roll__result">
    <span class="dice-total oc-roll__total">{{total}}</span>
    <span class="dice-formula oc-roll__formula">{{formula}}</span>
  </div>
  {{{tooltip}}}
</div>
