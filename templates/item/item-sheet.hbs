<div class="oc-item__card">
  <header class="oc-item__head">
    <img class="oc-item__img" src="{{item.img}}" alt="" data-edit="img" data-action="editImage">
    <div class="oc-item__titles">
      <span class="oc-item__kicker">{{typeLabel}}</span>
      <input class="oc-item__name" type="text" name="name" value="{{item.name}}" {{disabled (not editable)}}>
    </div>
    {{#if canRoll}}<a class="oc-button oc-button--dark oc-item__roll" data-action="roll"><i class="fa-solid fa-dice-d10"></i></a>{{/if}}
  </header>
  <div class="oc-item__body">
    {{> (lookup this "body")}}
    <div class="oc-prose oc-item__desc">
      {{formInput fields.description value=system.description enriched=enrichedDescription toggled=true editable=editable name="system.description"}}
    </div>
  </div>
</div>
