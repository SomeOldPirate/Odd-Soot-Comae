<form class="{{cssClass}} oddsoot-dossier" autocomplete="off">
  
  <header class="sheet-header">
    <div class="profile-img">
       <img src="{{actor.img}}" data-edit="img" title="{{actor.name}}"/>
    </div>
    
    <div class="header-data">
      <div class="char-name">
        <input name="name" type="text" value="{{actor.name}}" placeholder="Character Name"/>
      </div>
      
      <div class="concept-row">
        <input name="system.concept" type="text" value="{{system.concept}}" placeholder="Concept / Profession"/>
        
        <div class="luck-box">
          <label>LUCK</label>
          <input type="text" name="system.luck.value" value="{{system.luck.value}}" data-dtype="Number"/>
          <span class="sep">/</span>
          <input type="text" name="system.luck.max" value="{{system.luck.max}}" data-dtype="Number"/>
        </div>
      </div>

      <div class="aux-row">
        <div class="tags-input">
           <input name="system.tags" type="text" value="{{system.tags}}" placeholder="Tags (e.g. Wealthy, Hunted...)"/>
        </div>

        <div class="soot-compact">
          <a class="roll-soot label-link">SOOT</a>
          <div class="soot-val-wrapper">
             <input name="system.soot.value" type="number" value="{{system.soot.value}}" min="0" max="100"/>
             <span class="percent">%</span>
          </div>
        </div>
      </div>

    </div>
  </header>

  <div class="sheet-body">
    
    <aside class="sidebar">
      <h2 class="deco-header">Conflict Pools</h2>
      <div class="pools-grid">
        {{#each system.pools as |pool key|}}
        <div class="pool-card" data-pool="{{key}}">
          <label>{{key}}</label>
          <div class="pool-inputs">
            <input class="pool-current" name="system.pools.{{key}}.value" type="number" value="{{pool.value}}"/>
            <span class="sep">/</span>
            <input class="pool-max" name="system.pools.{{key}}.max" type="number" value="{{pool.max}}"/>
          </div>
        </div>
        {{/each}}
      </div>

      <h2 class="deco-header">Equipment</h2>
      <div class="gear-section">
        
        {{#if weapons}}
        <h3 class="gear-header">Weapons</h3>
        <ul class="gear-list">
          {{#each weapons as |item|}}
          <li class="item gear-row roll-weapon" data-item-id="{{item._id}}">
            <div class="gear-name">
              <i class="fas fa-crosshairs" style="margin-right:5px; color:#666; font-size:0.8em;"></i>
              <span class="item-name">{{item.name}}</span>
              <span class="gear-stat">({{item.system.damage}})</span>
            </div>
            <div class="item-controls">
              <a class="item-edit"><i class="fas fa-edit"></i></a>
              <a class="item-delete"><i class="fas fa-trash"></i></a>
            </div>
          </li>
          {{/each}}
        </ul>
        {{/if}}

        {{#if armor}}
        <h3 class="gear-header">Armor</h3>
        <ul class="gear-list">
          {{#each armor as |item|}}
          <li class="item gear-row" data-item-id="{{item._id}}">
            <div class="gear-name">
              <span class="item-name">{{item.name}}</span>
              <span class="gear-stat">(AP {{item.system.ap}})</span>
            </div>
            <div class="item-controls">
              <a class="item-edit"><i class="fas fa-edit"></i></a>
              <a class="item-delete"><i class="fas fa-trash"></i></a>
            </div>
          </li>
          {{/each}}
        </ul>
        {{/if}}

        <h3 class="gear-header">Gear</h3>
        <ul class="gear-list">
          {{#each gear as |item|}}
          <li class="item gear-row" data-item-id="{{item._id}}">
            <div class="gear-name">
              <span class="item-name">{{item.name}}</span>
              {{#if (gt item.system.quantity 1)}}
              <span class="gear-qty">x{{item.system.quantity}}</span>
              {{/if}}
            </div>
            <div class="item-controls">
              <a class="item-edit"><i class="fas fa-edit"></i></a>
              <a class="item-delete"><i class="fas fa-trash"></i></a>
            </div>
          </li>
          {{/each}}
        </ul>

      </div>
    </aside>

    <section class="main-content">
      <h2 class="deco-header">Skills & Focuses</h2>
      
      <ul class="skill-list">
        {{#each system.skills as |skill key|}}
        <li class="skill-row">
          <a class="roll-skill" data-key="{{key}}">{{key}}</a>
          
          <input class="skill-val" name="system.skills.{{key}}.value" type="number" value="{{skill.value}}"/>

          <div class="focus-area">
            {{#each (lookup ../focuses key) as |item|}}
              <div class="focus-tag {{#if item.system.isWeapon}}weapon-tag{{/if}}" data-item-id="{{item._id}}">
                <span class="focus-name">{{item.name}}</span>
                {{#if item.system.isWeapon}}
                  <span class="focus-damage">+{{item.system.damageBonus}}</span>
                {{/if}}
                <a class="focus-control item-delete"><i class="fas fa-times"></i></a>
              </div>
            {{/each}}
          </div>

          <input class="xp-check" type="checkbox" name="system.skills.{{key}}.exp" {{checked skill.exp}}/>
        </li>
        {{/each}}
      </ul>

      <h2 class="deco-header">Case Notes</h2>
      <div class="notes-area">
        {{editor system.notes target="system.notes" button=true owner=owner editable=editable}}
      </div>
      
    </section>

  </div>
</form>