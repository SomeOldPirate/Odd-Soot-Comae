<form>
  <div class="form-group">
    <label>Modifier</label>
    <input type="number" name="modifier" value="0" autofocus/>
  </div>

  <div class="form-group">
    <label>Use Focus (+20%)</label>
    <input type="checkbox" name="useFocus" {{#if hasFocus}}checked{{/if}}/>
  </div>

  {{#if isCombat}}
  <div class="form-group">
    <label>Weapon</label>
    <select name="weapon">
      <option value="">Standard / Improvised (1d6)</option>
      {{#each weapons}}
      <option value="{{_id}}">{{name}} ({{system.damage}})</option>
      {{/each}}
    </select>
  </div>
  {{/if}}
</form>